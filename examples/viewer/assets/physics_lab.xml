<mujoco model="Flutter native physics lab">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <default>
    <geom friction="0.8 0.05 0.01" solref="0.01 1"/>
    <joint damping="0.12"/>
  </default>
  <asset>
    <texture name="ground" type="2d" builtin="checker" width="512" height="512"
             rgb1=".2 .3 .4" rgb2=".1 .15 .2" mark="cross" markrgb=".8 .8 .8"/>
    <material name="ground" texture="ground" texrepeat="1 1" texuniform="true"/>
    <mesh name="tetra" vertex="0 0 0  0.3 0 0  0 0.3 0  0 0 0.4"/>
  </asset>
  <worldbody>
    <geom name="floor" type="plane" size="4 4 0.1" material="ground"/>
    <body name="support" pos="-1 0 0">
      <geom type="box" pos="0 0 0.08" size="0.45 0.4 0.08" rgba="0.3 0.4 0.45 1"/>
      <geom type="cylinder" pos="0 0 1" size="0.07 0.99" rgba="0.5 0.6 0.65 1"/>
      <body name="pendulum" pos="0 0 2">
        <joint name="hinge" type="hinge" axis="0 1 0"/>
        <geom type="capsule" fromto="0 0 0  0 0 -1.1" size="0.075" rgba="0.6 0.9 0.3 1"/>
        <geom type="sphere" pos="0 0 -1.1" size="0.18" mass="1" rgba="0.8 0.95 0.4 1"/>
      </body>
    </body>
    <body name="box" pos="0.5 0 2.5">
      <freejoint/>
      <geom type="box" size="0.2 0.25 0.2" rgba="0.95 0.5 0.25 1"/>
    </body>
    <body name="ball" pos="1.2 0.25 3.2">
      <freejoint/>
      <geom type="sphere" size="0.23" rgba="0.3 0.65 0.95 1"/>
    </body>
    <body name="ellipsoid" pos="0.2 0.7 1.8">
      <freejoint/>
      <geom type="ellipsoid" size="0.3 0.15 0.2" rgba="0.7 0.4 0.9 1"/>
    </body>
    <body name="mesh" pos="0.8 -0.65 1.8">
      <freejoint/>
      <geom type="mesh" mesh="tetra" rgba="0.9 0.7 0.2 1"/>
    </body>
  </worldbody>
  <actuator><motor name="pendulum_motor" joint="hinge" ctrlrange="-5 5"/></actuator>
</mujoco>
